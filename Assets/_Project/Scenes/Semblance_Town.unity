  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Semblance.Investigation.EvidenceItem
  prompt: Inspect
  id: hollis_bedroll
  title: A bedroll in the barn
  text: A bedroll in the end stall, a thermos, a box of shells. Somebody sleeps out here, and has for a month by the state of the blanket. The straw beside it is pressed flat where a shotgun lies at night.
  subject: Harlan Hollis
  customPrompt: Look at the bedroll
  nerveShock: 0
  awareness: 0
