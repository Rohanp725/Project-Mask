  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Semblance.Investigation.EvidenceItem
  prompt: Inspect
  id: vance_card
  title: A funeral card
  text: 'CARL JAMES VANCE. 1931-1979. ''Gone before us.'' The card has been folded and unfolded so many times the crease has gone soft as cloth. On the back, in pencil: ''porch light''.'
  subject: Irene Vance
  customPrompt: Read the card
  nerveShock: 0
  awareness: 0
