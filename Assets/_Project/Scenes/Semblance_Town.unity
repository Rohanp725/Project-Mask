  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Semblance.Investigation.EvidenceItem
  prompt: Inspect
  id: bell_note
  title: Note on the back pew
  text: '''I ring it at three and count who comes running. They all come. Every one of them. 212. Then why does the sign say 213? Somebody paints it at night. I paint it back. It comes back.'' Signed W.D.'
  subject: Wendell Dobbs
  customPrompt: 
  nerveShock: 0
  awareness: 0
