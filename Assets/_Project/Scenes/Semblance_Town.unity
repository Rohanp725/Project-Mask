  m_Script: {fileID: 11500000, guid: d4efa34bdb1340e43aceb06caf98b86f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Semblance.Investigation.EvidenceItem
  prompt: Inspect
  id: calder_knitting
  title: Ruth's knitting
  text: 'Ruth''s knitting, a half-finished sleeve. Somebody has kept adding to it since August. The new rows are even, machine-even, and they''re knitted backwards: every stitch mirrored, the way a left hand makes a right hand''s work.'
  subject: Amos Calder
  customPrompt: Look at the knitting
  nerveShock: 0
  awareness: 0
