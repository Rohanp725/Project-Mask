  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Semblance.Investigation.EvidenceItem
  prompt: Inspect
  id: wendell_tally
  title: Water-stained tally book
  text: 'Sundays going back years, every soul counted: 212, 212, 212... In September a new column: SIGN. 213, 213, 213, every morning, however many times he painted it back. Then a page in capitals: IT WANTS TO BE COUNTED. I HAVE WRITTEN TO THE CITY. The last line is pressed so hard it tore: WHICH ONE.'
  subject: Wendell Dobbs
  customPrompt: 
  nerveShock: 0
  awareness: 0
