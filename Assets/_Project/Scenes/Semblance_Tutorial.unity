  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Semblance.Interaction.InspectableObject
  prompt: Read the letter
  description: 'A plain envelope, postmarked SEMBLANCE, OCT 10. Inside, one line in pencil, pressed hard enough to tear the paper:


    <i>"One of us is not one of us."</i>


    Clipped to it, in the sheriff''s hand: <i>Klein. Look into this.</i>'
  messageDuration: 5
  clueKey: tut_letter
