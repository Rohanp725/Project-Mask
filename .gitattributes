# Unity YAML assets are text: diff them as text, keep line endings stable
*.cs text eol=lf
*.shader text eol=lf
*.hlsl text eol=lf
*.cginc text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.meta text eol=lf
*.json text eol=lf
*.md text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.wav binary
*.ttf binary
*.fbx binary
